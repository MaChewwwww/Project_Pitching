# Staging — the team's day-to-day environment: feature testing, live
# integrations, safe to break. Copy to .env.staging before running the stack:
#   make env ENV=staging   (or just `make env` — staging is the default profile)
# .env.staging is gitignored and must never be committed (NFR-SEC-010).
# Full reference: docs/architecture.md Section 13.1/13.2
#
# Runs as its own Compose project (`sagip-staging`) so it can run alongside
# the demo profile — separate database, separate volumes, separate ports —
# without either one touching the other.

# --- Database ---------------------------------------------------------------
# Consumed by the `db` container to initialise the cluster.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=appdb

# Consumed by `api` and `cron`. Host is the compose service name, not localhost.
# psycopg3 serves both the async app engine and Alembic's sync engine.
DATABASE_URL=postgresql+psycopg://app:app_dev_password@db:5432/appdb

# --- Auth -------------------------------------------------------------------
# Generate a real one before any deployment:  openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# false on plain HTTP, true once HTTPS is enabled (tech_stack.md Section 9).
# Never hardcode this — a Secure cookie is silently dropped over HTTP.
COOKIE_SECURE=false

# --- HTTP ---------------------------------------------------------------
ENVIRONMENT=staging

CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Where the browser reaches the API. Everything goes through the proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Where the `web` container reaches the API — Next.js Server Components run inside
# that container and cannot resolve `localhost:8080` (there is no proxy hop from
# container to container). Server-to-server, over the Compose network directly.
API_INTERNAL_BASE_URL=http://api:8000/api/v1

# Host ports. Staging keeps the original defaults; the demo profile
# (.env.demo.example) uses a different set so both stacks can run at once.
PROXY_PORT=8080
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433

# --- External data sources --------------------------------------------------
# Barangay San Jose, Rodriguez (Montalban), Rizal — centroid of the clip extent
# in dataset/README.md.
OPEN_METEO_LAT=14.735
OPEN_METEO_LON=121.135

PAGASA_STATION=Montalban
SCRAPE_INTERVAL_MINUTES=15

# A reading older than this is rendered as stale (FR-WX-011).
STALE_THRESHOLD_MINUTES=45

# --- Barangay operational configuration ------------------------------------
# Runtime values formerly edited from the retired /admin/config screen.
BARANGAY_TOTAL_POPULATION=143031
# Leave blank until the official LGU household denominator is confirmed.
BARANGAY_TOTAL_HOUSEHOLDS=
ALERT_THRESHOLD_LEVEL_1_M=22.40
ALERT_THRESHOLD_LEVEL_2_M=23.00
ALERT_THRESHOLD_LEVEL_3_M=23.60

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=5

# --- Operations ---------------------------------------------------------
LOG_LEVEL=INFO

# true switches readings to a scripted timeline for the pitch (FR-WX-016, not
# built — see the "Simulate typhoon" admin action instead for now).
DEMO_MODE=false
