# Copy to the repository root as .env.capture. This file is intentionally ignored.
CAPTURE_BASE_URL=https://57-155-90-155.sslip.io
CAPTURE_ADMIN_EMAIL=
CAPTURE_ADMIN_PASSWORD=
CAPTURE_RESIDENT_PASSWORD=
CAPTURE_SETTLE_MS=550
CAPTURE_SCROLL_PAUSE_MS=280
# Wait for the shared full-page splash to finish before recorder interactions.
CAPTURE_LOADER_TIMEOUT_MS=8000
CAPTURE_LOADER_SETTLE_MS=300
# Set true only when you intend to create clearly tagged records on staging.
CAPTURE_MUTATIONS=false
# Optional: use a stable id while rehearsing; otherwise one is generated per run.
CAPTURE_RUN_ID=
