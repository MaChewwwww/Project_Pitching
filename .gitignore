# --- Dataset ---
# Raw source downloads only. The clipped GeoJSON in dataset/derived/ IS committed —
# see dataset/README.md and docs/architecture.md Section 12.5. Do not add a blanket
# "dataset/" ignore here; that would gitignore the derived files too.
dataset/raw/

# Leftover / regenerable preview artifacts
tools/preview_map.html
dataset/noah/

# --- Node / Next.js (apps/web, packages/api-types) ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# --- Python (apps/api, services/cron, tools/) ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Build artifacts / copies (not a second source of truth) ---
apps/web/public/data/*.geojson

# Intermediate step of `make types`. Only the generated .ts is committed, because
# that is what CI diffs (architecture.md 12.4).
packages/api-types/openapi.json

# Database dumps — runtime data, and they can be large.
infra/backups/*.dump

# --- Secrets & local env ---
.env
.env.*
!.env*.example
*.pem

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*

# --- Runtime data (lives on a volume, not in git) ---
uploads/
.aider*

# --- Pitch capture output (generated, local-only) ---
artifacts/demo-captures/
.env.capture

# --- Documentation & Doc Build Scripts ---
docs/year-1-budget-overview.md
docs/SAGIP-SJ-Year-1-Budgetary-Quotation-Draft.docx
docs/SAGIP-SJ-Year-1-Quotation-Annexes-Draft.docx
docs/SAGIP-SJ-Annex-B-Existing-Prototype-Baseline.docx
tools/build_budget_quotation.py
tools/build_quotation_annexes.py
tools/build_brd_docx.py
tools/build_annex_b.py