# Demo — the curated, isolated environment for the pitch. Copy to .env.demo
# before running the stack:
#   make env ENV=demo
# .env.demo is gitignored and must never be committed (NFR-SEC-010).
# Full reference: docs/architecture.md Section 13.1/13.2
#
# Runs as its own Compose project (`sagip-demo`) — separate database, separate
# volumes, separate ports from staging (.env.staging.example) — so testing a
# feature in staging can never corrupt the seeded scenario sitting ready for
# the pitch. Both can run on the same laptop at the same time.
#
# Reseed fresh right before presenting:  make clean ENV=demo && make dev ENV=demo

# --- Database ---------------------------------------------------------------
# Consumed by the `db` container to initialise the cluster.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=appdb

# Consumed by `api` and `cron`. Host is the compose service name, not localhost.
# psycopg3 serves both the async app engine and Alembic's sync engine.
DATABASE_URL=postgresql+psycopg://app:app_dev_password@db:5432/appdb

# --- Auth -------------------------------------------------------------------
# Generate a real one before any deployment:  openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# false on plain HTTP, true once HTTPS is enabled (tech_stack.md Section 9).
# Never hardcode this — a Secure cookie is silently dropped over HTTP.
COOKIE_SECURE=false

# --- HTTP ---------------------------------------------------------------
ENVIRONMENT=demo

CORS_ORIGINS=http://localhost:8090,http://localhost:3010

# Where the browser reaches the API. Everything goes through the proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090/api/v1

# Where the `web` container reaches the API — Next.js Server Components run inside
# that container and cannot resolve `localhost:8090` (there is no proxy hop from
# container to container). Server-to-server, over the Compose network directly.
API_INTERNAL_BASE_URL=http://api:8000/api/v1

# Host ports — deliberately offset from staging (.env.staging.example) so both
# profiles can run at once without colliding on the same host port.
PROXY_PORT=8090
WEB_PORT=3010
API_PORT=8010
DB_PORT=5443

# --- External data sources --------------------------------------------------
# Barangay San Jose, Rodriguez (Montalban), Rizal — centroid of the clip extent
# in dataset/README.md.
OPEN_METEO_LAT=14.735
OPEN_METEO_LON=121.135

PAGASA_STATION=Montalban
SCRAPE_INTERVAL_MINUTES=15

# A reading older than this is rendered as stale (FR-WX-011).
STALE_THRESHOLD_MINUTES=45

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=5

# --- Operations ---------------------------------------------------------
LOG_LEVEL=INFO

# true switches readings to a scripted timeline for the pitch (FR-WX-016, not
# built). The admin console's "Simulate typhoon" action (readings page) is the
# lighter-weight alternative: an on-demand, presenter-triggered river-level
# sequence, rather than a fully automated timeline.
DEMO_MODE=false
