# Normalise to LF in the repository. Windows checkouts get CRLF for text files
# unless listed below; anything executed inside a Linux container must stay LF.
* text=auto eol=lf

# Files that break if they arrive with CRLF inside a container
*.sh          text eol=lf
Makefile      text eol=lf
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf
Caddyfile     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Windows-native helpers keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch, never diff
*.shp    binary
*.shx    binary
*.dbf    binary
*.docx   binary
*.png    binary
*.jpg    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.woff2  binary

# Generated — collapse in review, but still committed and diff-checked in CI
packages/api-types/src/generated.ts linguist-generated=true
package-lock.json                   linguist-generated=true
uv.lock                             linguist-generated=true

# Large committed data — do not try to be clever about it
dataset/derived/*.geojson text eol=lf -diff
