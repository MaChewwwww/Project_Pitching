# One entry point. `/api/*` to FastAPI, `/uploads/*` to the volume, everything
# else to Next.js (tech_stack.md Section 9).
#
# Plain HTTP is the baseline the app must work on. Geolocation and camera are
# blocked on non-secure origins by the browser — that is why the manual paths
# (draggable pin, gallery upload) are the primary ones, not a fallback.
#
# To enable HTTPS: replace `:80` below with the sslip.io hostname for your VPS
# IP, e.g. `203-0-113-5.sslip.io`. Caddy fetches a Let's Encrypt certificate
# itself — no account, no DNS panel. Then set COOKIE_SECURE=true in .env.

:80 {
	log {
		output stdout
		format json
	}

	encode gzip zstd

	# Uploads are served straight from the volume. They are stored outside the
	# web root and never pass through the app (NFR-SEC-008).
	handle_path /uploads/* {
		root * /srv/uploads
		file_server {
			# User-submitted files: never let the browser sniff or execute them.
			precompressed
		}
		header {
			Content-Disposition "inline"
			X-Content-Type-Options "nosniff"
			Cache-Control "public, max-age=86400"
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
